# ── Web Push (all optional — leave empty for zero server cost) ──
#
# Default (everything empty):
#   • Custom UI + browser Notification.requestPermission() only
#   • No /api/push/* calls, no service worker, no DB, no Vercel function usage
#
# When you are ready to collect subscribers (before sending campaigns):
#   1. Generate keys: node scripts/generate-vapid.mjs
#   2. Set NEXT_PUBLIC_VAPID_PUBLIC_KEY + VAPID_PRIVATE_KEY
#   3. Set DATABASE_URL (Neon/Postgres)
#   4. Set NEXT_PUBLIC_PUSH_PERSIST_SUBSCRIPTIONS=true
#
# Sending notifications is a separate admin step (/api/push/send) — not invoked automatically.

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_PUSH_PERSIST_SUBSCRIPTIONS=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
DATABASE_URL=
