# ── Web Push: subscriber collection + send from PC ──
#
# 1) Generate keys on your PC:
#      pnpm push:keys
# 2) Create free Neon Postgres → copy DATABASE_URL
# 3) Paste all values below into .env.local AND Vercel env
# 4) Redeploy — subscribers will accumulate in Neon automatically

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_PUSH_PERSIST_SUBSCRIPTIONS=true
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@1weapp.online
DATABASE_URL=
ADMIN_PUSH_SECRET=

# ── Admin CMS (optional — persist edits from /admin on serverless) ──
# GITHUB_TOKEN=ghp_...
# GITHUB_REPO=owner/pwa-website-structure
# GITHUB_BRANCH=main
# VERCEL_DEPLOY_HOOK=https://api.vercel.com/v1/integrations/deploy/...

# ── Send / manage from your PC ──
# Browser admin:  https://www.1weapp.online/admin/notifications
# Export to PC:    pnpm push:export   → data/push-subscribers.json
# Send from PC:    pnpm push:send -- --title "..." --body "..." --url "/ru"
# Send from backup pnpm push:send -- --from-local data/push-subscribers.json ...
